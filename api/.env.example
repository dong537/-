APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8010
WEB_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./data

FRAME_EXTRACT_INTERVAL_SECONDS=4
MAX_FRAME_ANALYSIS_COUNT=12
MAX_UPLOAD_BYTES=262144000
REQUEST_LOG_ENABLED=true

# mock: no external model call. openai: use OpenAI-compatible implementation later.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_VISION_MODEL=

# mock: demo route. amap: reserved for GaoDe Web Service integration.
MAP_PROVIDER=mock
AMAP_WEB_KEY=
AMAP_WEB_SERVICE_KEY=
